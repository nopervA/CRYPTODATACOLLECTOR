# Production defaults for Debian 12 (bookworm) on Google Cloud.
# Override any value here or via drop-in:
#   sudo systemctl edit binance-futures-collector

COLLECTOR_DATA_DIR=/var/lib/binance-futures-collector/data
COLLECTOR_LOG_DIR=/var/log/binance-futures-collector
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
LOG_LEVEL=INFO

# Optional: enable weekly GCS backup timer (see BACKUP.md)
BACKUP_ENABLED=0
# BACKUP_GCS_URI=gs://binance-futures-research-data
# BACKUP_GCS_PREFIX=weekly
# BACKUP_REPORT_DIR=/opt/binance-futures-collector/backup_reports
# BACKUP_MAX_RETRIES=3
# BACKUP_STATUS_FILE=/var/lib/binance-futures-collector/backup_status.json

# Health-check staleness thresholds (minutes)
HEALTH_MAX_OI_AGE_MINUTES=5
HEALTH_MAX_FUNDING_AGE_MINUTES=15
HEALTH_MAX_TRADE_AGE_MINUTES=2
HEALTH_MAX_DEPTH_AGE_MINUTES=5

# Telegram alerts (optional — leave blank to disable)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_RATE_LIMIT_SECONDS=900
# TELEGRAM_DISK_FREE_GB_WARN=10
# TELEGRAM_DAILY_SUMMARY_HOUR_UTC=0
# TELEGRAM_DAILY_SUMMARY_MINUTE_UTC=5
# BACKUP_STATUS_FILE=/var/lib/binance-futures-collector/backup_status.json
