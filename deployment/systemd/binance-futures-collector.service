[Unit]
Description=Binance USDT-M Futures Research Data Collector
Documentation=file:///opt/binance-futures-collector/deployment/documentation/RECOVERY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=collector
Group=collector
WorkingDirectory=/opt/binance-futures-collector
EnvironmentFile=-/opt/binance-futures-collector/deployment/systemd/binance-futures-collector.env
ExecStartPre=+/opt/binance-futures-collector/deployment/scripts/ensure-runtime.sh
ExecStartPre=+/opt/binance-futures-collector/deployment/scripts/preflight.sh
ExecStart=/opt/binance-futures-collector/.venv/bin/python /opt/binance-futures-collector/main.py
Restart=always
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/binance-futures-collector /var/log/binance-futures-collector

StandardOutput=journal
StandardError=journal
SyslogIdentifier=binance-futures-collector

[Install]
WantedBy=multi-user.target
